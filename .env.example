# Keep the actual key only in your local .env file or in the server environment.
ROUTERAI_API_KEY=
ROUTERAI_BASE_URL=https://routerai.ru/api/v1
PDF2TZ_EMBEDDINGS_ENABLED=false
# Fixed BGE-M3 ONNX revision 4de13258303883538bd53b696b452bf8099f0858, outside the repository.
PDF2TZ_EMBEDDING_MODEL_PATH=/var/lib/pdf2tz/models/bge-m3/4de13258303883538bd53b696b452bf8099f0858
PDF2TZ_EMBEDDING_SIMILARITY_THRESHOLD=0.48
PDF2TZ_EMBEDDING_MAX_CANDIDATES=36
